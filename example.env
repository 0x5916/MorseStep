# PostgreSQL
POSTGRES_USER=opencw
POSTGRES_PASSWORD=
POSTGRES_DB=opencw
DB_PORT=5432
# Host path for PostgreSQL data (set this to your external disk mount in LXC)
POSTGRES_DATA_PATH=/data/postgres

# PostgreSQL resource tuning
# The db service derives its settings (shared_buffers, work_mem, the worker counts and so
# on) from the memory and CPU it actually has: an explicit limit, then its cgroup limit,
# then the host. Everything below overrides that, and everything below is optional.
# Sizes accept Compose's byte syntax: 512mb, 2g, or a plain byte count.
#
# Set these two when the database shares a host with anything else. They are also the
# container's mem_limit and cpus, so 0 means "no limit". Set them explicitly on an LXC or
# nested-container host: /proc/meminfo there usually reports the physical machine, so
# leaving these at 0 makes the tuner guess from the wrong number. Keep
# POSTGRES_MEMORY_LIMIT above POSTGRES_SHM_SIZE, because /dev/shm is charged to the
# container's memory limit.
POSTGRES_MEMORY_LIMIT=0
POSTGRES_CPU_LIMIT=0
# Shared memory for parallel queries. Compose fixes this when the container is created,
# so the tuner can only warn about it, not adjust it.
POSTGRES_SHM_SIZE=2gb
# Server-side connection ceiling. Keep it comfortably above DB_MAX_OPEN_CONNS plus the
# pgAdmin and backup connections; it also divides work_mem.
POSTGRES_MAX_CONNECTIONS=100
# Percentage of host memory the database may assume when no limit is set above. 50 is
# deliberately conservative because the rest of the stack shares the host.
POSTGRES_HOST_MEMORY_SHARE=50
# 1 skips the derived values and uses the image's own defaults.
POSTGRES_TUNE_DISABLE=0
# Extra server arguments, appended last so they win, e.g. -c work_mem=32MB
POSTGRES_TUNE_EXTRA=

# pgAdmin 4 admin UI
# PGADMIN_DEFAULT_EMAIL is the login for pgAdmin itself. It is an email address, NOT a
# PostgreSQL role. Set it once - pgAdmin derives its own storage paths from it.
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
# Host port for the pgAdmin UI. It is published on 127.0.0.1 only; public access goes through
# the Cloudflare tunnel (see DEPLOYMENT.md) behind a Zero Trust Access policy.
PGADMIN_PORT=5050

# Backend
# JWT secret must be base64-encoded bytes (≥ 32 raw bytes recommended).
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Required: backend/internal/configs/config.go validates this on startup and exits
# if it is empty, so a blank value crash-loops the backend container.
RESEND_API_KEY=
RESEND_FROM_EMAIL=OpenCW <no-reply@example.com>

# Comma-separated list of origins the browser is allowed to call the API from.
CORS_ORIGINS=http://localhost:3000,https://www.opencw.net,https://opencw.net

# Backend runtime tuning
READ_TIMEOUT=15s
READ_HEADER_TIMEOUT=5s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=20s

# Backend DB pool tuning
DB_MAX_OPEN_CONNS=30
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# Cloudflare Tunnel (optional profile in docker compose)
CLOUDFLARED_TUNNEL_TOKEN=
CLOUDFLARED_PROTOCOL=quic

# Frontend (build-time)
# URL the *browser* uses to reach the backend API.
# For local access with the default port mappings:
PUBLIC_API_BASE=https://api.opencw.net/v1
