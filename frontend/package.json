{
  "name": "cw-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "paraglide:compile": "node --experimental-strip-types scripts/compile-paraglide.ts",
    "check": "svelte-kit sync && npm run paraglide:compile && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && npm run paraglide:compile && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "verify": "npm run messages:validate && npm run seo:validate && npm run check && npm run check:scripts",
    "seo:validate": "node --experimental-strip-types scripts/validate-seo.ts",
    "messages:validate": "node --experimental-strip-types scripts/validate-messages.ts",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "^0.35.4",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.25.3",
    "@lucide/svelte": "^1.46.0"
  }
}
